[Unit]
Description=Name Everything AI job worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust WorkingDirectory / EnvironmentFile / ExecStart to your install path.
WorkingDirectory=/opt/name-everything
EnvironmentFile=/etc/name-everything/ai-worker.env
ExecStart=/opt/name-everything/node_modules/.bin/tsx ai-worker/index.ts
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
