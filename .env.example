# Supabase (Grammar Everything content + asset reports)
# Copy to .env.local for local dev. GitHub Actions: add as repository secrets.
# Do not commit real project refs, URLs, or keys.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
SUPABASE_PROJECT_REF=your_project_ref

# Database password (Supabase CLI / direct psql only — NOT used by the Vite app):
# SUPABASE_DB_PASSWORD=your_database_password

# Service role (scripts / ai-worker / smoke — never expose to Vite):
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI worker (VPS only — never VITE_, never GitHub Pages):
# DASHSCOPE_API_KEY=
# SUPABASE_URL=   # same project as VITE_SUPABASE_URL
# AI_QUOTA_PER_USER_PER_DAY=50
# AI_QUOTA_PER_USER_PER_MINUTE=20
# AI_QUOTA_GLOBAL_PER_MINUTE=60
# Device allow list: app_config key ai.allow_device_ids (not env)
